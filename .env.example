# Copia este archivo como .env.local y completa los valores de tu proyecto.
# Están en Supabase > Project Settings > API Keys (y Data API para la URL).
#
# Ambos valores son PÚBLICOS: viajan al navegador y están pensados para eso.
# La seguridad la ponen las reglas por fila de la base de datos.
# NUNCA pongas aquí la clave secreta (service_role / sb_secret_...).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_o_clave_anon
